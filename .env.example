# ---- 对话大脑（OpenAI 兼容后端：DeepSeek / GLM / Qwen 等） ----
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
CHAT_MODEL=deepseek-chat

# ---- Hermes Agent 网关（可选，agent 模式） ----
HERMES_BASE_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=your-hermes-gateway-key
HERMES_MODEL=hermes-agent

# ---- 视觉模型（image_to_prompt 工具，可选） ----
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VISION_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# VISION_MODEL=qwen-vl-max

# ---- 服务端默认模式（direct | hermes），前端未手动选择时采用 ----
WORKBENCH_AGENT_BACKEND=direct

# ---- SQLite 数据库路径（默认 <项目根>/data/workbench.db） ----
# WORKBENCH_DB_PATH=/absolute/path/to/workbench.db

# ---- 生产身份与默认租户引导（首次启动幂等创建） ----
# 生产环境必须配置邮箱与至少 12 位密码；未配置时身份解析保持 fail-closed。
# WORKBENCH_BOOTSTRAP_EMAIL=owner@example.com
# WORKBENCH_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
# WORKBENCH_BOOTSTRAP_DISPLAY_NAME=工作区管理员
# WORKBENCH_BOOTSTRAP_ORGANIZATION_ID=org_default
# WORKBENCH_BOOTSTRAP_ORGANIZATION_NAME=默认组织
# WORKBENCH_BOOTSTRAP_WORKSPACE_ID=default
# WORKBENCH_BOOTSTRAP_WORKSPACE_NAME=默认工作区

# ---- Mono Creative Service（平台统一托管，Chrome 扩展不保存供应商 Key）----
# MONO_PLATFORM_API_KEY=shared-service-token
# MONO_VIDEO_ANALYZE_URL=https://your-video-service.example.com/video/analyze
# 抖音分享链接解析端点（缺省时按 MONO_VIDEO_ANALYZE_URL 同级的 video/resolve 推导）
# MONO_VIDEO_RESOLVE_URL=https://your-video-service.example.com/video/resolve
# MONO_VIDEO_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# MONO_VIDEO_MODEL=your-video-model
# MONO_IMAGE_BASE_URL=https://your-image-service.example.com
# MONO_IMAGE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# MONO_IMAGE_MODEL=gpt-image-2
# Explicitly enables the trusted local Workbench actor and credential-free
# /api/mono access in non-production development. Never enable in production.
MONO_LOCAL_DEVELOPMENT=true
WORKBENCH_LOCAL_USER_ID=local-user
WORKBENCH_LOCAL_ORGANIZATION_ID=org_default
WORKBENCH_LOCAL_WORKSPACE_ID=default
WORKBENCH_PUBLIC_URL=http://127.0.0.1:3020
# Temporary no-login product pipeline preview. Keep disabled outside the trial window.
PRODUCT_TRIAL_ENABLED=false
# Optional stable HMAC secret for trial browser cookies; process-local fallback is used when omitted.
# PRODUCT_TRIAL_SECRET=replace-with-a-long-random-secret
# Set true only when the trial URL is served over HTTPS.
# PRODUCT_TRIAL_SECURE_COOKIE=false
# Optional workspace containing the reusable product model pairs.
# PRODUCT_TRIAL_WORKSPACE_ID=default
MONO_PLATFORM_USER_ID=mono-platform
MONO_PLATFORM_WORKSPACE_ID=default

# ---- 视频工具箱网关（网关与 Workbench 两端配置相同 token） ----
# TOOLBOX_GATEWAY_URL=http://192.168.1.198:8100
# TOOLBOX_TOKEN=replace-with-a-long-random-token
# 网关升级期间若必须读取旧的无租户文件/任务，可在网关端短期开启；完成迁移后关闭。
# TOOLBOX_ALLOW_LEGACY_TENANT=false
# 仅限网关进程所在机器的隔离开发环境，生产和局域网部署禁止开启。
# TOOLBOX_ALLOW_INSECURE_LOCAL=false

# ---- 商品套图白底图调度（安全上限：4 个商品 / 每商品 6 张 / 全局 12 张） ----
# 同一商品文件夹自动 FIFO 独占；以下值可向下调整以适配显存，不可突破安全上限。
# PRODUCT_PIPELINE_ACTIVE_FOLDERS=4
# PRODUCT_PIPELINE_FOLDER_CUTOUT_CONCURRENCY=6
# PRODUCT_PIPELINE_GLOBAL_CUTOUT_CONCURRENCY=12
# 商品套图产物（主图/SKU/images）存放根目录，与原图目录（【原图】-待制作）是两棵
# 不同的树；产物按原图文件夹的相对路径原样镜像过去。
# PRODUCT_PIPELINE_DETAIL_ROOT=Z:\型麦-得物-品牌\【详情页】-待审
# 商品套图模特一致性实验目录；未配置时使用 PRODUCT_PIPELINE_SOURCE_ROOT/test/model-consistency
# MODEL_CONSISTENCY_TEST_ROOT=Z:\型麦-得物-品牌\【原图】-待制作\test\model-consistency
# 网关端最终 GPU 保护阈值。它不再与上面的全局值一致，而是由显存实测决定：
# 抠图单进程在 2080 Ti 上占约 14.8GiB/22GiB，2 个并发峰值 22.1GiB，3 个必崩。
# 默认 1、上限 2：第 2 个进程只快约 20%，却吃光整张卡的余量。
# 上面那些值决定 Workbench 提交多少任务，多出来的在网关排队等显卡，这是正常的。
# TOOLBOX_PRODUCT_CUTOUT_CONCURRENCY=1

# ---- 对象存储（上传的视频/图片落盘目录，默认 <项目根>/data/storage） ----
# WORKBENCH_STORAGE_DIR=/absolute/path/to/storage
# WORKBENCH_UPLOAD_MAX_BYTES=2147483648

# ---- 大视频云存储（TOS，火山引擎对象存储，可选）----
# 本机上传的视频超过 base64 内嵌阈值（约 7.3MB）时，先传到这里换取模型可直接
# 拉取的签名链接；不配置时超阈值的视频分析会直接报错。
# TOS_AK=your-access-key-id
# TOS_SK=your-secret-access-key
# TOS_REGION=cn-beijing
# TOS_BUCKET=your-bucket-name

# ---- ComfyUI 统一 GPU 后端（抠像等视频处理能力，可选） ----
# COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_WORKFLOWS_DIR=/absolute/path/to/config/comfyui-workflows
# COMFYUI_TIMEOUT_MS=600000

# ---- 视频生成（Wan 2.2 本地 / 百炼 Wan 2.7 云端）----
# auto 不会在 provider 故障时静默切换；请明确选择其中之一。
# VIDEO_GENERATION_PROVIDER=comfyui
# VIDEO_GENERATION_PROVIDER=dashscope-wan
# VIDEO_GENERATION_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/api/v1
# VIDEO_GENERATION_API_KEY=sk-...
# VIDEO_GENERATION_T2V_MODEL=wan2.7-t2v-2026-06-12
# VIDEO_GENERATION_I2V_MODEL=wan2.7-i2v-2026-04-25
# MONO_VIDEO_GENERATION_TIMEOUT_MS=3600000

# ---- 罗盘数据只读 sidecar（采集机上运行 services/luopan-api/server.py，可选） ----
# LUOPAN_API_URL=http://127.0.0.1:8788
# LUOPAN_API_TOKEN=shared-readonly-token
