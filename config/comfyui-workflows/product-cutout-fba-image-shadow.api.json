{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{INPUT_IMAGE}}"
    }
  },
  "2": {
    "class_type": "LayerMask: RmBgUltra V2",
    "inputs": {
      "image": ["1", 0],
      "detail_method": "PyMatting",
      "detail_erode": 1,
      "detail_dilate": 1,
      "black_point": 0.01,
      "white_point": 0.99,
      "process_detail": false,
      "device": "cuda",
      "max_megapixels": 2.0
    }
  },
  "3": {
    "class_type": "FBA_Matting",
    "inputs": {
      "image": ["1", 0],
      "mask": ["2", 1],
      "max_side": 1920,
      "trimap_erode": 4,
      "trimap_dilate": 12,
      "weights_path": "D:\\hyk_sort\\prod-data\\comfyui-neo\\fba-test\\FBA.pth",
      "device": "cuda:0"
    }
  },
  "4": {
    "class_type": "FBA_CleanAlpha",
    "inputs": {
      "mask": ["3", 1],
      "threshold": 0.84,
      "erode": 5,
      "soften": 0.25
    }
  },
  "5": {
    "class_type": "GrowMask",
    "inputs": {
      "mask": ["4", 0],
      "expand": 5,
      "tapered_corners": true
    }
  },
  "6": {
    "class_type": "Image Shadows and Highlights",
    "inputs": {
      "image": ["3", 3],
      "shadow_threshold": 210,
      "shadow_factor": 1.5,
      "shadow_smoothing": 0.25,
      "highlight_threshold": 255,
      "highlight_factor": 0,
      "highlight_smoothing": 0.25,
      "simplify_isolation": 0
    }
  },
  "7": {
    "class_type": "FBA_ImageToMask",
    "inputs": {
      "image": ["6", 1],
      "channel": "red"
    }
  },
  "8": {
    "class_type": "MaskComposite",
    "inputs": {
      "destination": ["7", 0],
      "source": ["5", 0],
      "x": 0,
      "y": 0,
      "operation": "subtract"
    }
  },
  "9": {
    "class_type": "MaskBlur+",
    "inputs": {
      "mask": ["8", 0],
      "amount": 4,
      "device": "gpu"
    }
  },
  "10": {
    "class_type": "FBA_FitCanvas",
    "inputs": {
      "foreground": ["3", 0],
      "alpha": ["4", 0],
      "shadow": ["9", 0],
      "canvas_width": 1920,
      "canvas_height": 1280,
      "target_long_side": "{{TARGET_LONG_SIDE}}",
      "center_x": "{{CENTER_X}}",
      "center_y": "{{CENTER_Y}}",
      "shadow_strength": "{{SHADOW_STRENGTH}}"
    }
  },
  "11": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["10", 0],
      "filename_prefix": "{{OUTPUT_PREFIX}}_white_image_shadow"
    }
  },
  "12": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["10", 1],
      "filename_prefix": "{{OUTPUT_PREFIX}}_dark_image_shadow"
    }
  },
  "13": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["10", 2],
      "filename_prefix": "{{OUTPUT_PREFIX}}_alpha_image_shadow"
    }
  },
  "14": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["10", 3],
      "filename_prefix": "{{OUTPUT_PREFIX}}_shadow_image_shadow"
    }
  }
}
