{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{INPUT_IMAGE}}"
    }
  },
  "2": {
    "class_type": "ImageScale",
    "inputs": {
      "image": ["1", 0],
      "upscale_method": "lanczos",
      "width": 1920,
      "height": 1280,
      "crop": "disabled"
    }
  },
  "3": {
    "class_type": "EmptyImage",
    "inputs": {
      "width": 1920,
      "height": 1280,
      "batch_size": 1,
      "color": 16777215
    }
  },
  "4": {
    "class_type": "LayerMask: LoadBiRefNetModelV2",
    "inputs": {
      "version": "BiRefNet-General"
    }
  },
  "5": {
    "class_type": "LayerMask: BiRefNetUltraV2",
    "inputs": {
      "image": ["2", 0],
      "birefnet_model": ["4", 0],
      "detail_method": "GuidedFilter",
      "detail_erode": 2,
      "detail_dilate": 2,
      "black_point": 0.01,
      "white_point": 0.99,
      "process_detail": true,
      "device": "cuda",
      "max_megapixels": 2.0
    }
  },
  "6": {
    "class_type": "ThresholdMask",
    "inputs": {
      "mask": ["5", 1],
      "value": 0.4
    }
  },
  "7": {
    "class_type": "InvertMask",
    "inputs": {
      "mask": ["6", 0]
    }
  },
  "8": {
    "class_type": "LayerMask: ShadowHighlightMaskV2",
    "inputs": {
      "image": ["2", 0],
      "shadow_level_offset": 0,
      "shadow_range": 0.12,
      "highlight_level_offset": 0,
      "highlight_range": 0.25,
      "mask": ["7", 0]
    }
  },
  "9": {
    "class_type": "MaskBlur+",
    "inputs": {
      "mask": ["8", 0],
      "amount": 2,
      "device": "auto"
    }
  },
  "10": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": ["3", 0],
      "source": ["2", 0],
      "x": 0,
      "y": 0,
      "resize_source": false,
      "mask": ["9", 0]
    }
  },
  "11": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": ["10", 0],
      "source": ["2", 0],
      "x": 0,
      "y": 0,
      "resize_source": false,
      "mask": ["6", 0]
    }
  },
  "12": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["11", 0],
      "filename_prefix": "{{OUTPUT_PREFIX}}_white_shadow"
    }
  },
  "13": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": ["3", 0],
      "source": ["2", 0],
      "x": 0,
      "y": 0,
      "resize_source": false,
      "mask": ["6", 0]
    }
  },
  "14": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["13", 0],
      "filename_prefix": "{{OUTPUT_PREFIX}}_white_no_shadow"
    }
  }
}
